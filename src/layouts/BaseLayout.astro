---
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import StructuredData from "@components/StructuredData.astro";
import { site } from "@data/site";
import "@styles/global.css";

type Props = {
  title: string;
  description: string;
  path: string;
  includeFaq?: boolean;
  faqItems?: Array<{ question: string; answer: string }>;
};

const { title, description, path, includeFaq = false, faqItems } = Astro.props;
const canonical = new URL(path, site.domain).toString();
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={site.socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={site.socialImage} />
    <link rel="preload" as="image" href={site.heroImageAvif} type="image/avif" imagesizes="100vw" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <StructuredData pageTitle={title} pageDescription={description} pageUrl={canonical} includeFaq={includeFaq} faqItems={faqItems} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
