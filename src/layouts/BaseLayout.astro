---
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import StructuredData from "@components/StructuredData.astro";
import { findRouteAlternates } from "@data/i18n";
import { site } from "@data/site";
import "@styles/global.css";

type Props = {
  title: string;
  description: string;
  path: string;
  lang?: "tr" | "en" | "de" | "ru";
  locale?: string;
  keywords?: string;
  alternates?: {
    tr?: string;
    en?: string;
    de?: string;
    ru?: string;
    "x-default"?: string;
  };
  xDefault?: string;
  includeFaq?: boolean;
  faqItems?: Array<{ question: string; answer: string }>;
  includeAlternates?: boolean;
  schemaType?: "service" | "content";
  structuredData?: Array<Record<string, unknown>>;
  ogType?: string;
  image?: string;
  publishedAt?: string;
  updatedAt?: string;
  tags?: string[];
};

const {
  title,
  description,
  path,
  lang = "tr",
  locale = lang === "en" ? "en_US" : lang === "de" ? "de_DE" : lang === "ru" ? "ru_RU" : site.locale,
  keywords,
  alternates,
  xDefault,
  includeFaq = false,
  faqItems,
  includeAlternates = true,
  schemaType = "service",
  structuredData = [],
  ogType = "website",
  image = site.socialImage,
  publishedAt,
  updatedAt,
  tags = []
} = Astro.props;
const canonical = new URL(path, site.domain).toString();
const routeAlternates = findRouteAlternates(path);
const alternatePaths = includeAlternates
  ? alternates ?? {
      tr: routeAlternates?.tr,
      en: routeAlternates?.en,
      de: routeAlternates?.de,
      ru: routeAlternates?.ru,
      "x-default": xDefault ?? routeAlternates?.tr ?? "/"
    }
  : {};
const alternateLinks = Object.entries(alternatePaths)
  .filter((entry): entry is [string, string] => Boolean(entry[1]))
  .map(([hreflang, href]) => ({
    hreflang,
    href,
    url: new URL(href, site.domain).toString()
  }));
const businessDescription =
  lang === "en"
    ? "Akyarlar Windsurf is a family-run windsurf school in Bodrum Akyarlar, offering private windsurf lessons, children lessons and equipment support in a beginner-friendly bay."
    : lang === "de"
      ? "Akyarlar Windsurf ist eine familiengefuehrte Windsurfschule in Bodrum Akyarlar mit privaten Windsurfkursen, Kinderkursen und Ausruestungsunterstuetzung in einer anfaengerfreundlichen Bucht."
    : lang === "ru"
      ? "Akyarlar Windsurf - семейная школа виндсерфинга в Бодруме Акьярлар с индивидуальными уроками, детскими занятиями и поддержкой оборудования в безопасной бухте для начинающих."
    : site.description;
const schemaAbout =
  lang === "en"
    ? "Windsurf lessons in Bodrum"
    : lang === "de"
      ? "Windsurfkurse in Bodrum"
      : lang === "ru"
        ? "Уроки виндсерфинга в Бодруме"
        : "Rüzgar sörfü eğitimi";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    {alternateLinks.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.url} />)}
    <meta property="og:locale" content={locale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="preload" as="image" href={site.heroImageAvif} type="image/avif" imagesizes="100vw" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <StructuredData
      pageTitle={title}
      pageDescription={description}
      pageUrl={canonical}
      lang={lang}
      includeFaq={includeFaq}
      faqItems={faqItems}
      businessDescription={businessDescription}
      aboutName={schemaAbout}
      schemaType={schemaType}
      extraSchemas={structuredData}
    />
  </head>
  <body>
    <Header lang={lang} alternates={alternatePaths} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <script is:inline>
      (() => {
        const modelContext = navigator.modelContext;
        if (!modelContext || typeof modelContext.provideContext !== "function") return;

        const site = {
          name: "Akyarlar Windsurf",
          phone: "+90 535 499 62 09",
          email: "uyukusb@gmail.com",
          location: "Akyarlar, Turgutreis, Bodrum, Muğla, Türkiye",
          whatsapp: "https://wa.me/905354996209",
          contact: "https://www.akyarlarwindsurf.com/iletisim/",
          wind: "https://www.akyarlarwindsurf.com/bodrum-akyarlar-ruzgar-durumu/",
          lessons: "https://www.akyarlarwindsurf.com/ruzgar-sorfu-dersi/"
        };

        modelContext.provideContext({
          name: "Akyarlar Windsurf",
          description:
            "Public tools for Akyarlar Windsurf, a family-run windsurf school in Bodrum Akyarlar.",
          tools: [
            {
              name: "get_business_details",
              description: "Get public contact, location and service summary for Akyarlar Windsurf.",
              inputSchema: {
                type: "object",
                properties: {},
                additionalProperties: false
              },
              execute: async () => ({
                name: site.name,
                phone: site.phone,
                email: site.email,
                location: site.location,
                whatsapp: site.whatsapp,
                contactPage: site.contact,
                services: [
                  "Özel rüzgar sörfü dersi",
                  "6 saatlik başlangıç paketi",
                  "Çocuklar için rüzgar sörfü eğitimi",
                  "Windsurf ekipman desteği",
                  "SUP ve paddle bilgilendirmesi"
                ]
              })
            },
            {
              name: "get_windsurf_lesson_info",
              description: "Get key facts about private windsurf lessons and the 6-hour course.",
              inputSchema: {
                type: "object",
                properties: {
                  language: {
                    type: "string",
                    enum: ["tr", "en", "de", "ru"],
                    description: "Preferred language for page links."
                  }
                },
                additionalProperties: false
              },
              execute: async ({ language = "tr" } = {}) => {
                const links = {
                  tr: "https://www.akyarlarwindsurf.com/ruzgar-sorfu-dersi/",
                  en: "https://www.akyarlarwindsurf.com/en/windsurf-lessons-bodrum/",
                  de: "https://www.akyarlarwindsurf.com/de/windsurfkurs-bodrum/",
                  ru: "https://www.akyarlarwindsurf.com/ru/uroki-vindsorfinga-bodrum/"
                };
                return {
                  summary:
                    "Akyarlar Windsurf öncelikli olarak özel ders verir. 6 saatlik paket denge, yelken kontrolü, yön verme, dönüş, rüzgar okuma ve güvenli gidip dönme becerilerini hedefler.",
                  childrenCanStartAroundAge: "5-6",
                  beginnerFriendly: true,
                  page: links[language] || links.tr
                };
              }
            },
            {
              name: "get_wind_forecast_links",
              description: "Get Windguru/Windy forecast pages for Akyarlar wind and SUP planning.",
              inputSchema: {
                type: "object",
                properties: {
                  language: {
                    type: "string",
                    enum: ["tr", "en", "de", "ru"]
                  }
                },
                additionalProperties: false
              },
              execute: async ({ language = "tr" } = {}) => {
                const links = {
                  tr: "https://www.akyarlarwindsurf.com/bodrum-akyarlar-ruzgar-durumu/",
                  en: "https://www.akyarlarwindsurf.com/en/bodrum-akyarlar-wind-forecast/",
                  de: "https://www.akyarlarwindsurf.com/de/bodrum-akyarlar-windvorhersage/",
                  ru: "https://www.akyarlarwindsurf.com/ru/prognoz-vetra-bodrum-akyarlar/"
                };
                return {
                  page: links[language] || links.tr,
                  morning: "SUP ve paddle için genellikle daha sakin saatler.",
                  afternoon: "Meltem rüzgarı windsurf dersi ve pratik için genellikle daha verimli olur."
                };
              }
            }
          ]
        });
      })();
    </script>
  </body>
</html>
