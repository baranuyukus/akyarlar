---
import { site } from "@data/site";

const currentPath = Astro.url.pathname;
type Props = {
  lang?: "tr" | "en";
  alternates?: {
    tr?: string;
    en?: string;
    "x-default"?: string;
  };
};

const { lang = "tr", alternates = {} } = Astro.props;
const isEn = lang === "en";

const isCurrent = (href: string) => currentPath === href;
const labels = isEn
  ? {
      address: "Akyarlar, Bodrum / Türkiye",
      brandSmall: "Bodrum Windsurf School",
      menu: "Open menu",
      home: "Home",
      services: "Services",
      school: "Bodrum Windsurf School",
      lessons: "Windsurf Lessons",
      rental: "Equipment Rental",
      akyarlar: "Akyarlar",
      guide: "Guide",
      bay: "Akyarlar Bay",
      paddle: "Bodrum Paddle Board",
      waterSports: "Water Sports",
      windForecast: "Wind Forecast",
      wind: "Wind",
      contact: "Contact"
    }
  : {
      address: site.shortAddress,
      brandSmall: "Bodrum Rüzgar Sörfü Okulu",
      menu: "Menüyü aç",
      home: "Ana Sayfa",
      services: "Hizmetler",
      school: "Bodrum Windsurf Okulu",
      lessons: "Rüzgar Sörfü Dersi",
      rental: "Ekipman Kiralama",
      akyarlar: "Akyarlar",
      guide: "Rehber",
      bay: "Akyarlar Koyu",
      paddle: "Bodrum Paddle",
      waterSports: "Su Sporları",
      windForecast: "Rüzgar Durumu",
      wind: "Rüzgar",
      contact: "İletişim"
    };
const paths = isEn
  ? {
      home: "/en/",
      school: "/en/bodrum-windsurf-school/",
      lessons: "/en/windsurf-lessons-bodrum/",
      rental: "/en/windsurf-rental-bodrum/",
      akyarlar: "/en/akyarlar-windsurf-spot/",
      bay: "/en/akyarlar-bay-guide/",
      paddle: "/en/bodrum-paddle-board/",
      waterSports: "/en/bodrum-water-sports/",
      windForecast: "/en/bodrum-akyarlar-wind-forecast/",
      contact: "/en/contact/"
    }
  : {
      home: "/",
      school: "/bodrum-ruzgar-sorfu-okulu/",
      lessons: "/ruzgar-sorfu-dersi/",
      rental: "/kiralama/",
      akyarlar: "/akyarlar/",
      bay: "/akyarlar-koyu-rehberi/",
      paddle: "/bodrum-paddle/",
      waterSports: "/bodrum-su-sporlari/",
      windForecast: "/bodrum-akyarlar-ruzgar-durumu/",
      contact: "/iletisim/"
    };
const trHref = alternates.tr ?? "/";
const enHref = alternates.en ?? "/en/";
---

<header class="site-header" data-site-header>
  <div class="header-strip">
    <a href={site.mapUrl}>{labels.address}</a>
    <a href={`tel:${site.phoneE164}`}>{site.phoneDisplay}</a>
  </div>
  <div class="header-main">
    <a class="brand" href={paths.home} aria-label={isEn ? "Akyarlar Windsurf home page" : "Akyarlar Windsurf ana sayfa"}>
      <span class="brand-mark">AW</span>
      <span>
        <strong>Akyarlar Windsurf</strong>
        <small>{labels.brandSmall}</small>
      </span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-menu-toggle>
      <span></span>
      <span></span>
      <span></span>
      <span class="sr-only">{labels.menu}</span>
    </button>

    <nav class="nav" id="primary-nav" aria-label={isEn ? "Main menu" : "Ana menü"} data-primary-nav>
      <a href={paths.home} aria-current={isCurrent(paths.home) ? "page" : undefined}>{labels.home}</a>
      <div class="nav-item has-menu">
        <button class="nav-trigger" type="button" aria-expanded="false">
          {labels.services}
          <span aria-hidden="true">⌄</span>
        </button>
        <div class="nav-menu">
          <a href={paths.school} aria-current={isCurrent(paths.school) ? "page" : undefined}>
            {labels.school}
          </a>
          <a href={paths.lessons} aria-current={isCurrent(paths.lessons) ? "page" : undefined}>
            {labels.lessons}
          </a>
          <a href={paths.rental} aria-current={isCurrent(paths.rental) ? "page" : undefined}>
            {labels.rental}
          </a>
        </div>
      </div>
      <a href={paths.akyarlar} aria-current={isCurrent(paths.akyarlar) ? "page" : undefined}>{labels.akyarlar}</a>
      <div class="nav-item has-menu">
        <button class="nav-trigger" type="button" aria-expanded="false">
          {labels.guide}
          <span aria-hidden="true">⌄</span>
        </button>
        <div class="nav-menu">
          <a href={paths.bay} aria-current={isCurrent(paths.bay) ? "page" : undefined}>
            {labels.bay}
          </a>
          <a href={paths.paddle} aria-current={isCurrent(paths.paddle) ? "page" : undefined}>
            {labels.paddle}
          </a>
          <a href={paths.waterSports} aria-current={isCurrent(paths.waterSports) ? "page" : undefined}>
            {labels.waterSports}
          </a>
          <a href={paths.windForecast} aria-current={isCurrent(paths.windForecast) ? "page" : undefined}>
            {labels.windForecast}
          </a>
        </div>
      </div>
      <a href={paths.windForecast} aria-current={isCurrent(paths.windForecast) ? "page" : undefined}>{labels.wind}</a>
      <a href={paths.contact} aria-current={isCurrent(paths.contact) ? "page" : undefined}>{labels.contact}</a>
    </nav>

    <div class="language-switcher" aria-label={isEn ? "Language selection" : "Dil seçimi"}>
      <a href={trHref} aria-current={!isEn ? "true" : undefined}>TR</a>
      <a href={enHref} aria-current={isEn ? "true" : undefined}>EN</a>
    </div>
    <a class="header-cta" href={site.whatsapp}>WhatsApp</a>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.querySelector("[data-site-header]");
    const toggle = document.querySelector("[data-menu-toggle]");
    const nav = document.querySelector("[data-primary-nav]");

    if (!header || !toggle || !nav) return;

    const setOpen = (open) => {
      header.toggleAttribute("data-menu-open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(!header.hasAttribute("data-menu-open"));
    });

    nav.addEventListener("click", (event) => {
      if (event.target.closest("a")) setOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });

    document.addEventListener("click", (event) => {
      if (!header.contains(event.target)) setOpen(false);
    });
  })();
</script>
