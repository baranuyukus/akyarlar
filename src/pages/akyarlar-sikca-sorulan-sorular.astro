---
import OptimizedImage from "@components/OptimizedImage.astro";
import SectionHeading from "@components/SectionHeading.astro";
import { faqSets, pageMeta, site } from "@data/site";
import BaseLayout from "@layouts/BaseLayout.astro";

const meta = pageMeta.akyarlarFaq;
---

<BaseLayout title={meta.title} description={meta.description} path={meta.path} includeFaq faqItems={faqSets.akyarlarFaq}>
  <section class="section alt">
    <div class="container split">
      <div>
        <p class="eyebrow">Akyarlar Sıkça Sorulan Sorular</p>
        <h1>Bodrum merkez Akyarlar arası kaç km, nasıl gidilir?</h1>
        <p>
          Bodrum merkez ile Akyarlar arası D330 üzerinden yaklaşık 23-24 kilometredir.
          Sezon yoğunluğu ve yol durumuna göre yolculuk çoğu zaman 35-40 dakika sürer.
          Bodrum merkez otogardan ya da güzergah üzerindeki duraklardan belediye otobüsleri
          ve özel otobüslerle Akyarlar'a ulaşım mümkündür.
        </p>
        <div class="actions">
          <a class="button" href={site.mapUrl}>Yol tarifi al</a>
          <a class="button ghost" href="/akyarlar-koyu-rehberi/">Akyarlar rehberi</a>
          <a class="button ghost" href="/ruzgar-sorfu-dersi/">Rüzgar sörfü dersi</a>
        </div>
      </div>
      <div class="image-panel quiet">
        <OptimizedImage
          src={site.heroImage}
          webp={site.heroImageWebp}
          avif={site.heroImageAvif}
          alt="Bodrum Akyarlar koyu ve berrak deniz"
          width={1600}
          height={1063}
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Kısa cevaplar"
        title="Akyarlar'a gelmeden önce en çok merak edilenler"
        text="Bu sayfa eski Akyarlar sıkça sorulan sorular içeriğinin güncel ve daha kapsamlı versiyonudur. Ulaşım, deniz yapısı, aileler için uygunluk ve rüzgar sörfü koşullarını tek yerde toplar."
      />
      <div class="grid">
        <article class="card">
          <h3>23-24 km mesafe</h3>
          <p>Bodrum merkezden Akyarlar'a ulaşım D330 üzerinden yaklaşık 23-24 kilometredir. Yaz trafiğinde süre değişebilir.</p>
        </article>
        <article class="card">
          <h3>Otobüsle ulaşım</h3>
          <p>Bodrum merkez otogardan ve yol üzerindeki duraklardan Akyarlar yönüne belediye otobüsleri ve özel otobüsler bulunur.</p>
        </article>
        <article class="card">
          <h3>Rüzgar ve deniz</h3>
          <p>Sabahları sakin ve berrak deniz, öğleden sonra ise düzenli meltem rüzgarı Akyarlar'ı su sporları için güçlü kılar.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container article-body">
      <article class="article-section">
        <h2>Bodrum merkezden Akyarlar'a nasıl gidilir?</h2>
        <p>
          Özel araçla Bodrum merkezden D330 güzergahına çıkıp Turgutreis yönünde ilerleyerek
          Akyarlar tabelalarını takip edebilirsiniz. Yol yaklaşık 23-24 kilometredir. Normal
          koşullarda 35-40 dakika civarında sürer; yaz aylarında sahil ve kavşak yoğunluğu
          nedeniyle bu süre uzayabilir.
        </p>
        <p>
          Toplu taşıma kullanacak misafirler Bodrum merkez otogardan kalkan ya da yol üstündeki
          duraklardan geçen belediye otobüsleri ve özel otobüslerle Akyarlar'a ulaşabilir.
          Sezon içinde sefer sıklığı değişebileceği için yola çıkmadan önce güncel saatleri
          kontrol etmek iyi olur.
        </p>
      </article>

      <article class="article-section">
        <h2>Akyarlar denizi nasıl?</h2>
        <p>
          Akyarlar denizi berrak, serin ve temiz yapısıyla bilinir. Koyun fiziksel formu açık
          deniz dalgalarını büyük ölçüde kestiği için birçok gün su yüzeyi kontrollüdür. Bu
          durum çocuklu aileler, yüzmek isteyenler, paddle yapanlar ve ilk kez rüzgar sörfü
          deneyecek öğrenciler için büyük avantaj sağlar.
        </p>
        <ul class="check-list">
          <li>Sabah saatlerinde deniz çoğu gün daha sakin olur.</li>
          <li>Öğleden sonra meltem rüzgarı rüzgar sörfü için uygun koşullar oluşturur.</li>
          <li>Temiz ve berrak su yapısı Akyarlar'ı Bodrum'un sevilen koylarından biri yapar.</li>
        </ul>
      </article>

      <article class="article-section">
        <h2>Akyarlar rüzgar sörfü için neden uygun?</h2>
        <p>
          Akyarlar'ın dalgalara kapalı koy yapısı, geniş sığ alanları ve düzenli rüzgarı rüzgar
          sörfü eğitimi için güvenli bir ortam sağlar. Yeni başlayan öğrenciler ilk derslerde
          denge, yelken kontrolü ve dönüşleri daha sakin bir denizde çalışabilir. İleri seviyede
          ise düzenli termik rüzgar harness, footstrap ve hız kontrolü pratiği için fırsat verir.
        </p>
        <div class="actions">
          <a class="button" href="/ruzgar-sorfu-dersi/">6 saatlik özel ders paketini incele</a>
          <a class="button ghost" href={site.whatsapp}>WhatsApp'tan sor</a>
        </div>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="SSS" title="Akyarlar hakkında sık sorulan sorular" />
      <div class="faq-grid">
        {faqSets.akyarlarFaq.map((faq) => (
          <article class="faq">
            <h3>{faq.question}</h3>
            <p>{faq.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
