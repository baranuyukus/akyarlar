---
import OptimizedImage from "@components/OptimizedImage.astro";
import SectionHeading from "@components/SectionHeading.astro";
import { getNotePath, latestNotes, notesIndexMeta } from "@data/notes";
import { site } from "@data/site";
import BaseLayout from "@layouts/BaseLayout.astro";

const formatDate = (date: string) =>
  new Intl.DateTimeFormat("tr-TR", {
    day: "numeric",
    month: "long",
    year: "numeric"
  }).format(new Date(`${date}T12:00:00+03:00`));

const pageUrl = new URL(notesIndexMeta.path, site.domain).toString();
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": ["CollectionPage", "Blog"],
  "@id": `${pageUrl}#hocalarimizdan-notlar`,
  name: notesIndexMeta.title,
  description: notesIndexMeta.description,
  url: pageUrl,
  inLanguage: "tr-TR",
  publisher: {
    "@id": `${site.domain}/#organization`
  },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: latestNotes.map((note, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(getNotePath(note), site.domain).toString(),
      name: note.title
    }))
  }
};
---

<BaseLayout
  title={notesIndexMeta.title}
  description={notesIndexMeta.description}
  path={notesIndexMeta.path}
  keywords={notesIndexMeta.keywords}
  includeAlternates={false}
  schemaType="content"
  structuredData={[collectionSchema]}
>
  <section class="section alt notes-landing">
    <div class="container">
      <SectionHeading
        eyebrow="Hocalarımızdan Notlar"
        title="Sahadan kısa, gerçek ve işe yarayan windsurf notları"
        text="Akyarlar'da ders verirken en çok anlattığımız küçük ama önemli detayları burada topluyoruz. Rüzgarı, çocuk eğitimini, paddle saatlerini ve ilk ders hissini doğrudan sahadan okuyun."
      />

      <div class="note-grid">
        {latestNotes.map((note) => (
          <article class="note-card">
            <a href={getNotePath(note)} aria-label={`${note.title} yazısını oku`}>
              <OptimizedImage
                class="note-card-media"
                src={note.coverImage}
                webp={note.coverImageWebp}
                avif={note.coverImageAvif}
                alt={note.imageAlt}
                width={1000}
                height={664}
              />
            </a>
            <div class="note-card-body">
              <div class="note-meta">
                <span>{note.category}</span>
                <time datetime={note.publishedAt}>{formatDate(note.publishedAt)}</time>
              </div>
              <h2><a href={getNotePath(note)}>{note.title}</a></h2>
              <p>{note.description}</p>
              <a class="text-link" href={getNotePath(note)}>Notu oku</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
