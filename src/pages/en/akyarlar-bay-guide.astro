---
import OptimizedImage from "@components/OptimizedImage.astro";
import SectionHeading from "@components/SectionHeading.astro";
import { enFaqSets, enPageMeta } from "@data/en";
import { site } from "@data/site";
import BaseLayout from "@layouts/BaseLayout.astro";

const meta = enPageMeta.guide;
---

<BaseLayout title={meta.title} description={meta.description} path={meta.path} lang="en" keywords={meta.keywords} includeFaq faqItems={enFaqSets.akyarlar}>
  <section class="section alt">
    <div class="container split">
      <div>
        <p class="eyebrow">Akyarlar Bay guide</p>
        <h1>Akyarlar Bay: clear water and windsurfing in Bodrum</h1>
        <p><strong>Akyarlar Bay</strong> is known for clear water, a calmer bay shape, Kos views and a practical wind pattern for windsurfing, paddle board and family beach days.</p>
        <div class="actions"><a class="button" href="/en/windsurf-lessons-bodrum/">Windsurf lessons</a><a class="button ghost" href="/en/bodrum-paddle-board/">Paddle board</a></div>
      </div>
      <div class="image-panel quiet"><OptimizedImage src={site.heroImage} webp={site.heroImageWebp} avif={site.heroImageAvif} alt="Akyarlar Bay clear water in Bodrum" width={1600} height={1063} /></div>
    </div>
  </section>
  <section class="section">
    <div class="container article-body">
      <article class="article-section"><h2>What is the sea like in Akyarlar?</h2><p>The sea is clear, cool and usually more controlled inside the bay. Mornings are often calmer for swimming and paddle board, while afternoon wind can become better for windsurfing.</p></article>
      <article class="article-section"><h2>Why families like Akyarlar</h2><p>Restaurants, cafes and seating areas along the beach make it easier for families to spend the day while children or beginners take windsurf lessons.</p></article>
      <article class="article-section"><h2>How far is Akyarlar from Bodrum?</h2><p>Akyarlar is around 23-24 km from Bodrum center by the D330 route and close to Turgutreis. Travel time depends on the season and traffic.</p></article>
    </div>
  </section>
  <section class="section alt"><div class="container"><SectionHeading eyebrow="FAQ" title="Akyarlar Bay questions" /><div class="faq-grid">{enFaqSets.akyarlar.map((faq) => <article class="faq"><h3>{faq.question}</h3><p>{faq.answer}</p></article>)}</div></div></section>
</BaseLayout>
