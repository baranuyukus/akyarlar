---
import OptimizedImage from "@components/OptimizedImage.astro";
import SectionHeading from "@components/SectionHeading.astro";
import { ruFaqSets, ruPageMeta } from "@data/ru";
import { site } from "@data/site";
import BaseLayout from "@layouts/BaseLayout.astro";

const meta = ruPageMeta.akyarlar;
---

<BaseLayout title={meta.title} description={meta.description} path={meta.path} lang="ru" keywords={meta.keywords} includeFaq faqItems={ruFaqSets.akyarlar}>
  <section class="section alt">
    <div class="container split">
      <div>
        <p class="eyebrow">Akyarlar Windsurf Spot</p>
        <h1>Акьярлар: защищенный windsurf spot в Бодруме</h1>
        <p>
          <strong>Akyarlar Windsurf Spot</strong> ценен тем, что бухта закрывает большие волны,
          получает регулярный ветер и дает новичкам чувство контроля. Для многих это
          <strong>лучшая бухта для виндсерфинга в Бодруме</strong>.
        </p>
        <div class="actions">
          <a class="button" href="/ru/uroki-vindsorfinga-bodrum/">Уроки виндсерфинга</a>
          <a class="button ghost" href="/ru/bukhta-akyarlar-gid/">Гид по бухте</a>
        </div>
      </div>
      <div class="image-panel quiet">
        <OptimizedImage src={site.heroImage} webp={site.heroImageWebp} avif={site.heroImageAvif} alt="Akyarlar Windsurf Spot в Бодруме с чистой водой" width={1000} height={664} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Почему этот spot?" title="Контролируемый ветер, мелкая вода и чистое море" />
      <div class="grid">
        <article class="card"><h3>Новички</h3><p>Мелкие участки и меньше волны помогают с первым балансом, подъемом паруса и поворотами.</p></article>
        <article class="card"><h3>Продвинутые</h3><p>В подходящий ветер можно работать с трапецией, петлями, скоростью и carving.</p></article>
        <article class="card"><h3>Семьи</h3><p>Пляж удобен для ожидания, еды, наблюдения за уроками и спокойного дня у моря.</p></article>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <SectionHeading eyebrow="FAQ" title="Вопросы об Akyarlar Windsurf Spot" />
      <div class="faq-grid">
        {ruFaqSets.akyarlar.map((faq) => <article class="faq"><h3>{faq.question}</h3><p>{faq.answer}</p></article>)}
      </div>
    </div>
  </section>
</BaseLayout>
