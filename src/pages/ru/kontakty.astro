---
import { ruFaqSets, ruPageMeta } from "@data/ru";
import { site } from "@data/site";
import BaseLayout from "@layouts/BaseLayout.astro";

const meta = ruPageMeta.contact;
---

<BaseLayout title={meta.title} description={meta.description} path={meta.path} lang="ru" keywords={meta.keywords} includeFaq faqItems={ruFaqSets.contact}>
  <section class="section alt">
    <div class="container contact-panel">
      <div>
        <p class="eyebrow">Контакты</p>
        <h1>Записаться на уроки виндсерфинга в Бодруме Акьярлар</h1>
        <p>Свяжитесь с Akyarlar Windsurf до приезда, чтобы безопасно подобрать время, <strong>прогноз ветра Бодрум Акьярлар</strong> и оборудование под ваш уровень.</p>
      </div>
      <div class="contact-links">
        <a class="contact-link" href={`tel:${site.phoneE164}`}><span>Телефон</span><span>{site.phoneDisplay}</span></a>
        <a class="contact-link" href={site.whatsapp}><span>WhatsApp</span><span>Написать</span></a>
        <a class="contact-link" href={`mailto:${site.email}`}><span>Email</span><span>{site.email}</span></a>
        <a class="contact-link" href={site.mapUrl}><span>Адрес</span><span>Akyarlar, Bodrum</span></a>
      </div>
    </div>
  </section>
  <section class="section"><div class="container split"><div><p class="eyebrow">Локация</p><h2>{site.address}</h2><p>Akyarlar Windsurf находится в бухте Акьярлар в Бодруме и предлагает индивидуальные уроки, детские занятия и поддержку оборудования.</p><div class="actions"><a class="button" href={site.whatsapp}>Спросить запись</a><a class="button ghost" href={site.mapUrl}>Открыть Google Maps</a></div></div><div class="map-panel"><iframe src={site.mapEmbedUrl} width="600" height="450" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Akyarlar Windsurf на Google Maps"></iframe></div></div></section>
</BaseLayout>
